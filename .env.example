# Web
NEXT_PUBLIC_API_URL=http://localhost:8000

# API
APP_ENV=development
# SQLite works immediately. For PostgreSQL, use:
# APP_DATABASE_URL=postgresql+psycopg://reelpilot:reelpilot@localhost:5432/reelpilot
APP_DATABASE_URL=sqlite:///./reelpilot.db
APP_REDIS_URL=redis://localhost:6379/0
APP_AUTH_SECRET=change-this-development-secret-to-a-long-random-value
APP_ACCESS_TOKEN_MINUTES=10080
APP_MAX_COMMENTS_PER_MONTH=1000
APP_MAX_ANALYSES_PER_MONTH=100
APP_MAX_GENERATIONS_PER_MONTH=50
# auto uses OpenAI when OPENAI_API_KEY is set, otherwise the deterministic local fallback.
APP_EMBEDDING_PROVIDER=auto
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_GENERATION_PROVIDER=auto
APP_GENERATION_MODEL=gpt-5.6-terra
# For a free local demo, install Ollama and set APP_GENERATION_PROVIDER=ollama.
APP_OLLAMA_BASE_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen2.5:3b
APP_INSTAGRAM_APP_ID=
APP_INSTAGRAM_APP_SECRET=
APP_INSTAGRAM_REDIRECT_URI=http://localhost:8000/v1/instagram/callback
APP_INSTAGRAM_API_VERSION=v26.0
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/v1/integrations/instagram/callback
